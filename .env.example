# JEE NEXUS environment (example — never commit real credentials)

# Production PostgreSQL via the Supabase transaction pooler.
# The app connects as the dedicated `jee_app` role (created by
# supabase/migrations/0003_app_role.sql; password set via scripts/create_app_role.sh
# and stored in .secrets/supabase_db.env — gitignored).
# DATABASE_URL=postgresql://jee_app.<PROJECT_REF>:<APP_ROLE_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require

# Local/CI PostgreSQL (direct connection, no pooler needed)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jee_nexus_test

# Admin bootstrap: first registered user OR these emails get the admin role
ADMIN_EMAILS=admin@jee-nexus.dev

# Supabase project (kwavmbowgvgphaccrqlc, ap-south-1)
# Schema + RLS live in supabase/migrations/ and are applied via the management
# SQL endpoint (scripts/supabase_sql.py) as the table owner — never via
# `prisma db push` (see scripts/db_push.sh guard).
# SUPABASE_URL=https://kwavmbowgvgphaccrqlc.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Pages deploy (CI / scripts/deploy_landing.sh)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# GitHub push (CI)
# GITHUB_TOKEN=
