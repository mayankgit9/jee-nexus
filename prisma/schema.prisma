// JEE NEXUS — Prisma schema (PostgreSQL / Supabase production runtime)
// Mirrors supabase/migrations/*.sql exactly: snake_case tables/columns via
// @map, native enums for type/difficulty/verification/role, Json for jsonb
// columns, double precision for marks/answers, timestamptz for timestamps.
// SQLite dev runtime is retired — CI and production both run PostgreSQL.
// NEVER run `prisma db push` against the Supabase URL (see scripts/db_push.sh).

generator client {
  provider = "prisma-client-js"
}

// Cloudflare Workers runtime client (deployed app): pure-JS query compiler +
// pg-worker driver adapter through Hyperdrive. Local dev and CI keep using
// the node client above — same schema, two runtimes.
generator clientWorker {
  provider               = "prisma-client"
  output                 = "../src/generated/worker"
  runtime                = "cloudflare"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------- Enums (PG native types) ---------------------

enum QuestionType {
  mcq_single
  mcq_multi
  numerical

  @@map("question_type")
}

enum Difficulty {
  easy
  medium
  hard

  @@map("difficulty")
}

enum VerificationStatus {
  imported
  needs_review
  verified
  rejected

  @@map("verification_status")
}

enum AppRole {
  student
  admin

  @@map("app_role")
}

enum ConversationType {
  dm
  group
  lobby

  @@map("conversation_type")
}

// ----------------------------- Users & auth -----------------------------

model User {
  id           String    @id @default(cuid())
  /// Login identity (2026-11-28 auth rework: username + password sign-in).
  /// Backfilled 2026-11-28 from email prefixes for pre-rework accounts.
  username     String    @unique
  /// OPTIONAL — captured only for self-recovery (forgot username/password).
  email        String?   @unique
  passwordHash String    @map("password_hash")
  name         String?
  role         AppRole   @default(student)
  preferences  Json?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Presence: touched (≤1 write/45s) by requireUser(); "online" = < 5 min
  lastSeenAt   DateTime? @map("last_seen_at") @db.Timestamptz(6)

  sessions          Session[]
  attempts          Attempt[]
  bookmarks         Bookmark[]
  reports           Report[]
  examAttempts      ExamAttempt[]
  passwordResets    PasswordReset[]
  chatMemberships   ChatMember[]
  chatSentMessages  ChatMessage[]      @relation("ChatSender")
  chatCreatedChats  ChatConversation[] @relation("ChatCreator")
  chatTypingStates  ChatTyping[]
  chatReactions     ChatReaction[]
  chatMentions      ChatMention[]      @relation("ChatMentionee")
  weeklyWinners     WeeklyWinner[]     @relation("WeeklyWinnerUser")
  mistakeEntries    MistakeEntry[]
  revisionSchedules RevisionSchedule[]
  revisionAttempts  RevisionAttempt[]
  savedTestConfigs  SavedTestConfig[]
  formulaProgress   FormulaProgress[]
  chapterProgress   ChapterProgress[]
  dailyTarget       DailyTarget?

  @@map("app_users")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("app_sessions")
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("password_resets")
}

// ----------------------------- Taxonomy -----------------------------

model Subject {
  id       String  @id @default(cuid())
  key      String  @unique // physics | chemistry | mathematics
  name     String
  icon     String? // lucide icon key
  colorKey String? @map("color_key") // mint | gold | violet
  order    Int     @default(0) @map("sort_order")

  chapters  Chapter[]
  questions Question[]

  @@map("subjects")
}

model Chapter {
  id        String  @id @default(cuid())
  subjectId String  @map("subject_id")
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  key       String  @unique // physics:current-electricity ...
  name      String
  unit      String? // Mechanics | Organic Chemistry ...
  order     Int     @default(0) @map("sort_order")

  questions       Question[]
  chapterProgress ChapterProgress[]

  @@index([subjectId])
  @@map("chapters")
}

// ----------------------------- Questions -----------------------------

model Question {
  id                   String             @id @default(cuid())
  publicId             String             @unique @map("public_id") // JEM-2023-PHY-004 style slug
  subjectId            String             @map("subject_id")
  subject              Subject            @relation(fields: [subjectId], references: [id])
  chapterId            String             @map("chapter_id")
  chapter              Chapter            @relation(fields: [chapterId], references: [id])
  subtopic             String?
  type                 QuestionType
  text                 String // LaTeX via $...$ / $$...$$
  correctOptions       Json?              @map("correct_options") // [0,2]
  numericalAnswer      Float?             @map("numerical_answer") @db.DoublePrecision
  numericalTolerance   Float?             @map("numerical_tolerance") @db.DoublePrecision
  difficulty           Difficulty         @default(medium)
  sourceExam           String             @default("JEE Main") @map("source_exam")
  sourceYear           Int?               @map("source_year")
  sourceDate           String?            @map("source_date") // examination date if known
  sourceShift          String?            @map("source_shift") // e.g. "Shift 1"
  sourceQuestionNumber Int?               @map("source_question_number")
  sourceReference      String?            @map("source_reference") // citation for the sourced question
  verificationStatus   VerificationStatus @default(imported) @map("verification_status")
  tags                 Json               @default("[]")
  contentHash          String             @unique @map("content_hash") // normalized duplicate detection
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  options           QuestionOption[]
  images            QuestionImage[]
  solution          Solution?
  practiceAttempts  Attempt[]
  bookmarks         Bookmark[]
  reports           Report[]
  examQuestions     ExamQuestion[]
  hints             QuestionHint?
  mistakeEntries    MistakeEntry[]
  revisionSchedules RevisionSchedule[]
  revisionAttempts  RevisionAttempt[]

  @@index([subjectId, chapterId])
  @@index([sourceYear, subjectId])
  @@index([verificationStatus])
  @@index([type])
  @@map("questions")
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String   @map("question_id")
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  idx        Int
  text       String
  isCorrect  Boolean  @default(false) @map("is_correct")

  @@unique([questionId, idx])
  @@map("question_options")
}

model QuestionImage {
  id                  String    @id @default(cuid())
  questionId          String    @map("question_id")
  question            Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  kind                String    @default("question") // question | solution
  url                 String // e.g. /diagrams/planet-density.svg
  altText             String    @map("alt_text")
  caption             String?
  attribution         String? // provenance line displayed under the image
  /// true = figure unusable (watermark destroyed the content); hidden from
  /// every read path until an AI remake replaces the file (migration 0018)
  hidden              Boolean   @default(false) @map("hidden")
  isOriginalExamImage Boolean   @default(false) @map("is_original_exam_image")
  order               Int       @default(0) @map("sort_order")
  /// Image audit (migration 0019): ok | missing | broken | low_res | duplicate | unverified
  status              String    @default("ok")
  lastCheckedAt       DateTime? @map("last_checked_at") @db.Timestamptz(6)
  contentHash         String?   @map("content_hash") // byte hash — duplicate detection
  /// Original URL preserved when an admin replaces the file (never lose provenance)
  replacedFromUrl     String?   @map("replaced_from_url")
  /// true = AI-reconstructed diagram (original kept separately, labeled in UI)
  reconstructed       Boolean   @default(false)

  @@index([status])
  @@map("question_images")
}

model Solution {
  id                String    @id @default(cuid())
  questionId        String    @unique @map("question_id")
  question          Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  keyConcept        String?   @map("key_concept") // one-paragraph concept recap
  formulas          Json      @default("[]") // array of formula strings (LaTeX)
  body              String // full step-by-step derivation (markdown-lite + LaTeX)
  commonMistakes    String?   @map("common_mistakes")
  alternativeMethod String?   @map("alternative_method")
  verification      String? // final sanity check
  isAiGenerated     Boolean   @default(true) @map("is_ai_generated") // shown to users until expert-verified
  verifiedAt        DateTime? @map("verified_at") @db.Timestamptz(6)
  sourceReferences  Json      @default("[]") @map("source_references") // array of source citations
  /// Verification workflow (migration 0019): ai_generated | independently_checked |
  /// expert_verified | reported_for_correction. NEVER auto-set to a verified state.
  reviewStatus      String    @default("ai_generated") @map("review_status")
  reviewedBy        String?   @map("reviewed_by")
  reviewedAt        DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewNote        String?   @map("review_note")
  version           Int       @default(1)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  revisions SolutionRevision[]

  @@map("solutions")
}

/// Full snapshot of a solution at each edit/approval — admin revision history.
model SolutionRevision {
  id         String   @id @default(cuid())
  solutionId String   @map("solution_id")
  solution   Solution @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  questionId String   @map("question_id")
  version    Int
  snapshot   Json
  editedBy   String?  @map("edited_by")
  note       String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([solutionId, createdAt])
  @@map("solution_revisions")
}

/// AI solution-generation telemetry: one row per enrichment run (ok or failed).
model SolutionGenLog {
  id               String   @id @default(cuid())
  questionId       String   @map("question_id")
  status           String // ok | failed
  attempts         Int      @default(1)
  source           String? // web+ai | ai
  model            String?
  promptTokens     Int?     @map("prompt_tokens")
  completionTokens Int?     @map("completion_tokens")
  costUsd          Float?   @map("cost_usd") @db.DoublePrecision
  error            String?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@index([status, createdAt])
  @@map("solution_gen_log")
}

// ----------------------------- Exams / CBT -----------------------------

model ExamPattern {
  id              String  @id @default(cuid())
  key             String  @unique // jee-main-2025 | jee-main-2023 | custom
  name            String
  description     String?
  durationMinutes Int     @map("duration_minutes")
  config          Json // sections[] + marking scheme

  exams Exam[]

  @@map("exam_patterns")
}

model Exam {
  id          String      @id @default(cuid())
  title       String
  description String?
  kind        String // full_length | subject | chapter | custom | pyq_year
  patternId   String      @map("pattern_id")
  pattern     ExamPattern @relation(fields: [patternId], references: [id])
  subjectKey  String?     @map("subject_key") // for subject/chapter tests
  year        Int? // for pyq_year tests
  config      Json? // generation config (filters, counts, seed)
  createdById String?     @map("created_by_id")
  isPublished Boolean     @default(true) @map("is_published")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  examQuestions ExamQuestion[]
  attempts      ExamAttempt[]

  @@index([kind])
  @@map("exams")
}

model ExamQuestion {
  id           String              @id @default(cuid())
  examId       String              @map("exam_id")
  exam         Exam                @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionId   String              @map("question_id")
  question     Question            @relation(fields: [questionId], references: [id])
  order        Int                 @map("sort_order")
  section      String // physics | chemistry | mathematics
  sectionOrder Int                 @map("section_order")
  answers      ExamAttemptAnswer[]

  @@unique([examId, order])
  @@index([examId, section])
  @@map("exam_questions")
}

model ExamAttempt {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  examId           String    @map("exam_id")
  exam             Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  startedAt        DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  endsAt           DateTime  @map("ends_at") @db.Timestamptz(6) // server-authoritative deadline
  submittedAt      DateTime? @map("submitted_at") @db.Timestamptz(6)
  status           String    @default("in_progress") // in_progress | submitted | expired
  totalMarks       Float?    @map("total_marks") @db.DoublePrecision
  maxMarks         Float?    @map("max_marks") @db.DoublePrecision
  timeSpentSeconds Int?      @map("time_spent_seconds")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  answers ExamAttemptAnswer[]

  @@index([userId, startedAt])
  @@map("exam_attempts")
}

model ExamAttemptAnswer {
  id               String       @id @default(cuid())
  examAttemptId    String       @map("exam_attempt_id")
  examAttempt      ExamAttempt  @relation(fields: [examAttemptId], references: [id], onDelete: Cascade)
  examQuestionId   String       @map("exam_question_id")
  examQuestion     ExamQuestion @relation(fields: [examQuestionId], references: [id], onDelete: Cascade)
  selectedOptions  Json?        @map("selected_options") // array of indices
  numericalValue   String?      @map("numerical_value")
  isCorrect        Boolean?     @map("is_correct")
  marksAwarded     Float?       @map("marks_awarded") @db.DoublePrecision
  visited          Boolean      @default(false)
  markedForReview  Boolean      @default(false) @map("marked_for_review")
  timeSpentSeconds Int          @default(0) @map("time_spent_seconds")
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([examAttemptId, examQuestionId])
  @@map("exam_attempt_answers")
}

// ----------------------------- Practice & engagement -----------------------------

model Attempt {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId       String   @map("question_id")
  question         Question @relation(fields: [questionId], references: [id])
  selectedOptions  Json?    @map("selected_options") // array of indices
  numericalValue   String?  @map("numerical_value")
  isCorrect        Boolean? @map("is_correct")
  timeSpentSeconds Int      @default(0) @map("time_spent_seconds")
  hintsUsed        Int      @default(0) @map("hints_used")
  /// Offline-sync idempotency key (client-generated UUID); unique when present
  clientKey        String?  @map("client_key")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@index([userId, questionId])
  @@map("attempts")
}

model Bookmark {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String   @map("question_id")
  question   Question @relation(fields: [questionId], references: [id])
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, questionId])
  @@map("bookmarks")
}

// ----------------------------- Mistake Notebook (0019) -----------------------------

model MistakeEntry {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId    String    @map("question_id")
  question      Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  category      String    @default("conceptual") // conceptual|calculation|formula_forgotten|misread|time_management|incorrect_guess|other
  personalNote  String?   @map("personal_note")
  mistakeCount  Int       @default(1) @map("mistake_count")
  lastAnswer    Json?     @map("last_answer") // previous attempt snapshot
  lastMistakeAt DateTime  @default(now()) @map("last_mistake_at") @db.Timestamptz(6)
  correctedAt   DateTime? @map("corrected_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, questionId])
  @@index([userId, lastMistakeAt(sort: Desc)])
  @@map("mistake_entries")
}

// ----------------------------- Spaced repetition (0019) -----------------------------

model RevisionSchedule {
  id                 String    @id @default(cuid())
  userId             String    @map("user_id")
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId         String    @map("question_id")
  question           Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  source             String    @default("manual") // mistake|bookmark|chapter|subject|manual|custom|exam
  dueAt              DateTime  @map("due_at") @db.Timestamptz(6)
  intervalDays       Int       @default(1) @map("interval_days")
  consecutiveCorrect Int       @default(0) @map("consecutive_correct")
  consecutiveWrong   Int       @default(0) @map("consecutive_wrong")
  selfRating         String?   @map("self_rating") // easy|medium|difficult
  lastResult         Boolean?  @map("last_result")
  lastReviewedAt     DateTime? @map("last_reviewed_at") @db.Timestamptz(6)
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  attempts RevisionAttempt[]

  @@unique([userId, questionId])
  @@index([userId, dueAt])
  @@map("revision_schedule")
}

model RevisionAttempt {
  id               String            @id @default(cuid())
  userId           String            @map("user_id")
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId       String            @map("question_id")
  question         Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  scheduleId       String?           @map("schedule_id")
  schedule         RevisionSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  wasCorrect       Boolean?          @map("was_correct")
  hintsUsed        Int               @default(0) @map("hints_used")
  timeSpentSeconds Int               @default(0) @map("time_spent_seconds")
  selfRating       String?           @map("self_rating")
  reviewedAt       DateTime          @default(now()) @map("reviewed_at") @db.Timestamptz(6)

  @@index([userId, reviewedAt(sort: Desc)])
  @@map("revision_attempts")
}

// ----------------------------- Saved custom test configs (0019) -----------------------------

model SavedTestConfig {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  config     Json
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, updatedAt(sort: Desc)])
  @@map("saved_test_configs")
}

// ----------------------------- Formula cards (0019) -----------------------------

model FormulaCard {
  id          String   @id @default(cuid())
  subjectKey  String   @map("subject_key")
  chapterKey  String   @map("chapter_key")
  topic       String?
  title       String
  formula     String
  explanation String?
  conditions  String?
  units       String?
  tags        Json     @default("[]")
  source      String?
  status      String   @default("needs_review") // published|needs_review|rejected
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  progress FormulaProgress[]

  @@index([subjectKey, chapterKey])
  @@index([status])
  @@map("formula_cards")
}

model FormulaProgress {
  userId       String      @map("user_id")
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId       String      @map("card_id")
  card         FormulaCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  favorite     Boolean     @default(false)
  learned      Boolean     @default(false)
  personalNote String?     @map("personal_note")
  quizSeen     Int         @default(0) @map("quiz_seen")
  quizCorrect  Int         @default(0) @map("quiz_correct")
  lastSeenAt   DateTime?   @map("last_seen_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([userId, cardId])
  @@map("formula_progress")
}

// ----------------------------- Progressive hints (0019) -----------------------------

model QuestionHint {
  questionId String   @id @map("question_id")
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  hint1      String
  hint2      String?
  hint3      String?
  source     String   @default("derived") // derived|ai|admin
  status     String   @default("ai_generated") // ai_generated|independently_checked|expert_verified|needs_review
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("question_hints")
}

// ----------------------------- Syllabus tracker (0019) -----------------------------

model ChapterProgress {
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterId String   @map("chapter_id")
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  status    String   @default("not_started") // not_started|learning|completed|revision_required|strong
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([userId, chapterId])
  @@map("chapter_progress")
}

model DailyTarget {
  userId          String   @id @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetQuestions Int      @default(20) @map("target_questions")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("daily_targets")
}

model Report {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String    @map("question_id")
  question   Question  @relation(fields: [questionId], references: [id])
  reason     String // incorrect_answer | incorrect_solution | missing_diagram | typo | copyright | other
  details    String?
  status     String    @default("open") // open | resolved | dismissed
  resolution String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)

  @@index([status])
  @@index([questionId])
  @@map("reports")
}

model ImportJob {
  id               String   @id @default(cuid())
  adminId          String   @map("admin_id")
  fileName         String   @map("file_name")
  sourceFormat     String   @map("source_format") // json | csv
  totalRows        Int      @default(0) @map("total_rows")
  inserted         Int      @default(0)
  skippedDuplicate Int      @default(0) @map("skipped_duplicate")
  rejected         Int      @default(0)
  errors           Json? // array of row-level errors
  status           String   @default("completed") // running | completed | failed
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("import_jobs")
}

// ----------------------------- Community chat (DMs + study groups) -----------------------------

model ChatConversation {
  id          String           @id @default(cuid())
  type        ConversationType
  name        String? // groups only (1-60 chars)
  createdById String?          @map("created_by_id")
  createdBy   User?            @relation("ChatCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6) // bumped on new message — sidebar sort key

  members     ChatMember[]
  messages    ChatMessage[]
  typingState ChatTyping[]
  // reactions hang off messages; no direct list needed on the conversation

  @@index([updatedAt])
  @@map("chat_conversations")
}

model ChatMember {
  id             String           @id @default(cuid())
  conversationId String           @map("conversation_id")
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String           @map("user_id")
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String           @default("member") // member | admin (creator)
  lastReadAt     DateTime?        @map("last_read_at") @db.Timestamptz(6)
  joinedAt       DateTime         @default(now()) @map("joined_at") @db.Timestamptz(6)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("chat_members")
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String           @map("conversation_id")
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// NULL for lobby guest posts (no account) — display name lives in senderName
  senderId       String?          @map("sender_id")
  sender         User?            @relation("ChatSender", fields: [senderId], references: [id], onDelete: Cascade)
  /// Display-name snapshot: guest name for lobby posts, sender name for rows
  /// that should survive account deletion
  senderName     String?          @map("sender_name")
  body           String // 1-2000 chars, enforced in the API
  /// Rich shares (0019): { type: 'question'|'result'|'revision'|'collection', … }
  attachment     Json?
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  replyToId      String?          @map("reply_to_id")
  replyTo        ChatMessage?     @relation("ChatReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        ChatMessage[]    @relation("ChatReplies")
  deletedAt      DateTime?        @map("deleted_at") @db.Timestamptz(6)
  reactions      ChatReaction[]
  mentions       ChatMention[]

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

/// @mention notifications: one row per (message, mentioned member). Written
/// when a group message body contains "@<display name>" matching a member
/// (sender excluded); read_at stamps when the mentioned user reads the
/// conversation. Drives the "X mentioned you" toast + deep link.
model ChatMention {
  messageId String      @map("message_id")
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String      @map("user_id")
  user      User        @relation("ChatMentionee", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt    DateTime?   @map("read_at") @db.Timestamptz(6)

  @@id([messageId, userId])
  @@index([userId, createdAt])
  @@map("chat_mentions")
}

/// Typing indicators: one row per (conversation, user), refreshed every ~3s
/// while typing. "Currently typing" = updated_at within the last 6s — stale
/// rows are invisible by definition and removed by opportunistic cleanup.
model ChatTyping {
  conversationId String           @map("conversation_id")
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String           @map("user_id")
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([conversationId, userId])
  @@index([updatedAt])
  @@map("chat_typing")
}

/// Message reactions: one row per (message, user, emoji) — several different
/// emojis per user allowed, never the same one twice (composite key).
model ChatReaction {
  messageId String      @map("message_id")
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String      @map("user_id")
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([messageId, userId, emoji])
  @@index([messageId])
  @@map("chat_reactions")
}

/// Rate limiter state: one row per active key; a BEFORE trigger raises
/// RATE_LIMIT_EXCEEDED when hits would pass limit_max (window_seconds
/// defines the fixed window). The app only ever $executeRaw's an upsert —
/// zero reads, zero RETURNING, nothing Hyperdrive can cache (prod lessons
/// 2026-11-25).
model RateLimitCounter {
  key           String   @id
  windowStart   DateTime @map("window_start") @db.Timestamptz(6)
  hits          Int      @default(0)
  windowSeconds Int      @map("window_seconds")
  limitMax      Int      @map("limit_max")

  @@map("rate_limit_counters")
}

/// Pinned top-3 of each CLOSED leaderboard week (migration 0015). Written by
/// POST /api/leaderboard/snapshot (bearer-token gated, called by the weekly
/// GitHub Actions cron) using the same ranking logic as GET /api/leaderboard.
/// unique(windowStart, windowEnd, rank) makes snapshot re-runs idempotent.
/// userName is the display name at pin time; userId is SET NULL on deletion
/// so the hall of fame survives account cleanup.
model WeeklyWinner {
  id          String   @id @default(cuid())
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  windowEnd   DateTime @map("window_end") @db.Timestamptz(6)
  rank        Int
  userId      String?  @map("user_id")
  user        User?    @relation("WeeklyWinnerUser", fields: [userId], references: [id], onDelete: SetNull)
  userName    String   @map("user_name")
  attempts    Int
  correct     Int
  accuracy    Int
  timeSeconds Int      @default(0) @map("time_seconds")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([windowStart, windowEnd, rank])
  @@index([windowEnd(sort: Desc), rank])
  @@map("weekly_winners")
}
