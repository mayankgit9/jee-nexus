{
  "$schema": "node_modules/wrangler/config-schema.json",
  // JEE NEXUS — Cloudflare Workers deployment (OpenNext).
  // Build: bunx opennextjs-cloudflare build   (produces .open-next/)
  // Deploy: bunx wrangler deploy   (requires a token with Workers:Edit;
  //         the HYPERDRIVE binding additionally requires Hyperdrive:Edit)
  "name": "jee-nexus-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-01-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Serve on https://jee-nexus-app.jee-nexus.workers.dev
  // (the route must also be enabled per-script — see deploy script step 4)
  "workers_dev": true,
  // Postgres access for the deployed API routes — two supported modes
  // (db.ts picks HYPERDRIVE if bound, else the DATABASE_URL secret via
  // direct TCP from Workers):
  //   1. DATABASE_URL secret (works with the current token scope):
  //        bunx wrangler secret put DATABASE_URL --name jee-nexus-app
  //      postgresql://jee_app.kwavmbowgvgphaccrqlc:<PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
  //      (session pooler, port 5432 — NOT the transaction pooler for direct TCP)
  //   2. Hyperdrive binding (pooling + cache; needs a token with Hyperdrive:Edit
  //      to create the config — see scripts/deploy_app_cloudflare.sh):
  //      POST /accounts/{account}/hyperdrive/config  { name: "jee-nexus-db",
  //        origin: { host: aws-0-ap-south-1.pooler.supabase.com, port: 5432,
  //                  user: jee_app.kwavmbowgvgphaccrqlc, database: postgres } }
  //      then paste its id below and uncomment.
  // "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<hyperdrive-config-id>" }],
  "vars": {
    "ADMIN_EMAILS": "admin@jee-nexus.dev"
  },
  "observability": {
    "enabled": true
  }
}
