{
  "$schema": "node_modules/wrangler/config-schema.json",
  // JEE NEXUS — Cloudflare Workers deployment (OpenNext).
  // Build: bunx opennextjs-cloudflare build   (produces .open-next/)
  // Deploy: bunx wrangler deploy   (requires a token with Workers:Edit;
  //         the HYPERDRIVE binding additionally requires Hyperdrive:Edit)
  "name": "jee-nexus-app",
  "main": ".open-next/worker.js",
  // 2025-11-01: needs node:net + node:tls (pg driver TCP/TLS to Supabase via
  // nodejs_compat) — keep >= 2025-09 for full node:tls support.
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Serve on https://jee-nexus-app.jee-nexus.workers.dev
  // (the route must also be enabled per-script — see deploy script step 4)
  "workers_dev": true,
  // Postgres access — ACTIVE: Hyperdrive binding (created 2026-11-25 with the
  // account token; config name "jee-nexus-db", origin = Supabase session
  // pooler aws-0-ap-south-1.pooler.supabase.com:5432 as jee_app). Hyperdrive
  // terminates TLS at the CF edge, which bypasses the workerd node:tls wall
  // (see src/lib/db.ts). db.ts prefers this binding when present.
  // Fallback if the config is ever deleted: the DATABASE_URL worker secret
  // (direct TCP; requires Supabase SSL enforcement OFF) — see db.ts.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "0c3c964027f94d12b2bfb56a9534dac8" }],
  "vars": {
    "ADMIN_EMAILS": "admin@jee-nexus.dev"
  },
  "observability": {
    "enabled": true
  }
}
