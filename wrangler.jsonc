{
  "$schema": "node_modules/wrangler/config-schema.json",
  // JEE NEXUS — Cloudflare Workers deployment (OpenNext).
  // Build: bunx cloudflare build   (produces .open-next/)
  // Deploy: bunx wrangler deploy   (requires a token with Workers:Edit;
  //         the HYPERDRIVE binding additionally requires Hyperdrive:Edit)
  "name": "jee-nexus-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-01-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Postgres access for the deployed API routes. Create the Hyperdrive config
  // first (one-time):
  //   POST /accounts/{account}/hyperdrive/config  { name: "jee-nexus-db",
  //     origin: { host: aws-0-ap-south-1.pooler.supabase.com, port: 5432,
  //               user: jee_app.kwavmbowgvgphaccrqlc, database: postgres } }
  // then paste its id below and uncomment.
  // "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<hyperdrive-config-id>" }],
  "vars": {
    "ADMIN_EMAILS": "admin@jee-nexus.dev"
  },
  "observability": {
    "enabled": true
  }
}
